# LinkOps Console — environment variables
#
# The application requires NO secrets and runs with zero configuration; every
# variable below is optional with a sensible default. Copy this file to `.env`
# only if you need to override a default.
#
# (The A2UI bonus, which would need an AI provider key, is not implemented, so no
# credential-shaped variables exist.)

# Port the NestJS API listens on. Default: 3000.
# The Angular dev server (:4200) proxies /links, /fleet, and /api to this port.
PORT=3000
